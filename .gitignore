# ==============================================================================
# .gitignore - Projet NBA Stats Pipeline
# ==============================================================================

# ---- Python ----
# Bytecode et fichiers compilés
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution et packaging
build/
dist/
*.egg-info/
*.egg

# ---- Environnements virtuels ----
.venv/
venv/
env/
ENV/
.env

# ---- Tests et couverture ----
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# ---- Outils de développement ----
# mypy (vérificateur de types)
.mypy_cache/

# Ruff (linter/formatter)
.ruff_cache/

# IPython / Jupyter
.ipynb_checkpoints/
profile_default/

# ---- IDE et éditeurs ----
# VS Code
.vscode/
tempCodeRunnerFile.py

# PyCharm
.idea/

# ---- Données et bases de données ----
# Données brutes et traitées (à adapter selon vos besoins)
data/raw/*
data/processed/*

# Base de données DuckDB
*.duckdb
*.duckdb.wal

# ---- Logs ----
logs/
*.log

# ---- Configuration et secrets ----
.env
.envrc
*.pem
*.key
